PORT=3003
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Optional: PayU payments
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test

# Optional: Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: Twilio OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# Optional: bootstraps or updates the default super admin on server start
SUPERADMIN_EMAIL=superadmin@vybera.in
SUPERADMIN_PASSWORD=
